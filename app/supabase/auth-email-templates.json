  "mailer_subjects_email_change": "Confirm your new Naadvidya email",
  "mailer_templates_confirmation_content": "<div style=\"font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:32px 24px;background:#f5e8c8;color:#2b1a0e\"><div style=\"text-align:center;margin-bottom:28px\"><div style=\"font-size:32px;color:#6e1f1f;line-height:1;margin-bottom:6px\">नादविद्या</div><div style=\"color:#8b6e4e;font-size:11px;letter-spacing:0.2em;text-transform:uppercase\">Naadvidya</div></div><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Namaste,</p><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Welcome to Naadvidya — a curated academy for Indian Classical music. To finish creating your account, please confirm your email:</p><p style=\"text-align:center;margin:32px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;background:#6e1f1f;color:#f5e8c8;text-decoration:none;border-radius:4px;font-weight:600;font-family:Georgia,serif;font-size:15px\">Confirm my email</a></p><p style=\"font-size:13px;color:#8b6e4e;line-height:1.6;margin:0 0 8px\">If the button doesn't work, paste this link into your browser:</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.5;margin:0 0 24px;word-break:break-all\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #e8dcc4;margin:28px 0\"><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0 0 12px\">If you didn't sign up for Naadvidya, you can safely ignore this email. The confirmation link expires in 1 hour.</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0;text-align:center\">सुर से सुर मिलाओ — Learn Classical Music from India's Finest Gurus<br><a href=\"https://www.naadvidya.com\" style=\"color:#6e1f1f;text-decoration:none\">naadvidya.com</a></p></div>",
  "mailer_templates_recovery_content": "<div style=\"font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:32px 24px;background:#f5e8c8;color:#2b1a0e\"><div style=\"text-align:center;margin-bottom:28px\"><div style=\"font-size:32px;color:#6e1f1f;line-height:1;margin-bottom:6px\">नादविद्या</div><div style=\"color:#8b6e4e;font-size:11px;letter-spacing:0.2em;text-transform:uppercase\">Naadvidya</div></div><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Namaste,</p><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Someone (we hope it was you) requested a password reset for your Naadvidya account. Click below to choose a new password:</p><p style=\"text-align:center;margin:32px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;background:#6e1f1f;color:#f5e8c8;text-decoration:none;border-radius:4px;font-weight:600;font-family:Georgia,serif;font-size:15px\">Reset my password</a></p><p style=\"font-size:13px;color:#8b6e4e;line-height:1.6;margin:0 0 8px\">If the button doesn't work, paste this link into your browser:</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.5;margin:0 0 24px;word-break:break-all\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #e8dcc4;margin:28px 0\"><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0 0 12px\">If you didn't request this, your password is unchanged — you can ignore this email. The reset link expires in 1 hour.</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0;text-align:center\"><a href=\"https://www.naadvidya.com\" style=\"color:#6e1f1f;text-decoration:none\">naadvidya.com</a></p></div>",
  "mailer_templates_magic_link_content": "<div style=\"font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:32px 24px;background:#f5e8c8;color:#2b1a0e\"><div style=\"text-align:center;margin-bottom:28px\"><div style=\"font-size:32px;color:#6e1f1f;line-height:1;margin-bottom:6px\">नादविद्या</div><div style=\"color:#8b6e4e;font-size:11px;letter-spacing:0.2em;text-transform:uppercase\">Naadvidya</div></div><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Namaste,</p><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Use the link below to sign in to your Naadvidya account:</p><p style=\"text-align:center;margin:32px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;background:#6e1f1f;color:#f5e8c8;text-decoration:none;border-radius:4px;font-weight:600;font-family:Georgia,serif;font-size:15px\">Sign in</a></p><p style=\"font-size:13px;color:#8b6e4e;line-height:1.6;margin:0 0 8px\">If the button doesn't work, paste this link into your browser:</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.5;margin:0 0 24px;word-break:break-all\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #e8dcc4;margin:28px 0\"><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0 0 12px\">This link expires in 1 hour. If you didn't request it, you can safely ignore this email.</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0;text-align:center\"><a href=\"https://www.naadvidya.com\" style=\"color:#6e1f1f;text-decoration:none\">naadvidya.com</a></p></div>",
  "mailer_templates_invite_content": "<div style=\"font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:32px 24px;background:#f5e8c8;color:#2b1a0e\"><div style=\"text-align:center;margin-bottom:28px\"><div style=\"font-size:32px;color:#6e1f1f;line-height:1;margin-bottom:6px\">नादविद्या</div><div style=\"color:#8b6e4e;font-size:11px;letter-spacing:0.2em;text-transform:uppercase\">Naadvidya</div></div><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Namaste,</p><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">You've been invited to join Naadvidya — a curated academy for Indian Classical music. Click below to set up your account:</p><p style=\"text-align:center;margin:32px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;background:#6e1f1f;color:#f5e8c8;text-decoration:none;border-radius:4px;font-weight:600;font-family:Georgia,serif;font-size:15px\">Accept invitation</a></p><p style=\"font-size:13px;color:#8b6e4e;line-height:1.6;margin:0 0 8px\">If the button doesn't work, paste this link into your browser:</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.5;margin:0 0 24px;word-break:break-all\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #e8dcc4;margin:28px 0\"><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0;text-align:center\">सुर से सुर मिलाओ — Learn Classical Music from India's Finest Gurus<br><a href=\"https://www.naadvidya.com\" style=\"color:#6e1f1f;text-decoration:none\">naadvidya.com</a></p></div>",
  "mailer_templates_email_change_content": "<div style=\"font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:32px 24px;background:#f5e8c8;color:#2b1a0e\"><div style=\"text-align:center;margin-bottom:28px\"><div style=\"font-size:32px;color:#6e1f1f;line-height:1;margin-bottom:6px\">नादविद्या</div><div style=\"color:#8b6e4e;font-size:11px;letter-spacing:0.2em;text-transform:uppercase\">Naadvidya</div></div><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">Namaste,</p><p style=\"font-size:16px;line-height:1.7;margin:0 0 16px\">You requested to change the email on your Naadvidya account from <strong>{{ .Email }}</strong> to <strong>{{ .NewEmail }}</strong>. Please confirm by clicking below:</p><p style=\"text-align:center;margin:32px 0\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:12px 28px;background:#6e1f1f;color:#f5e8c8;text-decoration:none;border-radius:4px;font-weight:600;font-family:Georgia,serif;font-size:15px\">Confirm new email</a></p><p style=\"font-size:13px;color:#8b6e4e;line-height:1.6;margin:0 0 8px\">If the button doesn't work, paste this link into your browser:</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.5;margin:0 0 24px;word-break:break-all\">{{ .ConfirmationURL }}</p><hr style=\"border:none;border-top:1px solid #e8dcc4;margin:28px 0\"><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0 0 12px\">If you didn't request this change, please contact support@naadvidya.com immediately.</p><p style=\"font-size:12px;color:#8b6e4e;line-height:1.6;margin:0;text-align:center\"><a href=\"https://www.naadvidya.com\" style=\"color:#6e1f1f;text-decoration:none\">naadvidya.com</a></p></div>"
