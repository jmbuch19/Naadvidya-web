{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [
    { "path": "/api/cron/booking-timeout",          "schedule": "*/30 * * * *" },
    { "path": "/api/cron/session-reminders-24hr",   "schedule": "0 * * * *" },
    { "path": "/api/cron/session-reminders-1hr",    "schedule": "*/15 * * * *" },
    { "path": "/api/cron/session-starting",         "schedule": "*/5 * * * *" },
    { "path": "/api/cron/daily-room-creation",      "schedule": "30 0 * * *" },
    { "path": "/api/cron/homework-overdue-teacher", "schedule": "40 0 * * *" },
    { "path": "/api/cron/low-credits-check",        "schedule": "30 1 * * *" },
    { "path": "/api/cron/homework-due-reminder",    "schedule": "30 2 * * *" },
    { "path": "/api/cron/daily-admin-digest",       "schedule": "30 3 * * *" },
    { "path": "/api/cron/payout-reminder",          "schedule": "45 2 1,15 * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(icon-192|icon-512|icon-maskable|naad-vidya-mark|naad-vidya-logo).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    }
  ]
}
