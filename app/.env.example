# ============================================
# NAADVIDYA — .env.example
# Copy this file to .env.local and fill values
# NEVER commit .env.local to git
# ============================================

# ---- Supabase ----
# Get from: supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Never expose client-side

# ---- Cloudflare R2 ----
# Get from: Cloudflare dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=naadvidya-files
R2_PUBLIC_URL=https://files.naadvidya.in   # Custom domain on R2 bucket (set up in CF)

# ---- Daily.co ----
# Get from: dashboard.daily.co → Developers → API Keys
DAILY_API_KEY=your-daily-api-key
DAILY_API_BASE=https://api.daily.co/v1

# ---- Razorpay ----
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx        # Use test keys in development
RAZORPAY_KEY_SECRET=your-razorpay-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxx    # Safe to expose (public key)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret  # Set in Razorpay → Webhooks

# ---- Resend ----
# Get from: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@naadvidya.in
RESEND_FROM_NAME=Naadvidya

# ---- WhatsApp Business (Meta Cloud API) ----
# Get from: developers.facebook.com → WhatsApp → API Setup
# Leave blank in Phase 1 if Meta Business account not verified
META_WHATSAPP_TOKEN=your-whatsapp-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
META_WEBHOOK_VERIFY_TOKEN=choose-any-random-string   # You set this yourself

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000      # Change to https://naadvidya.in in production
NEXT_PUBLIC_APP_NAME=Naadvidya

# ---- Cron (if using Vercel cron or external) ----
CRON_SECRET=choose-a-long-random-secret-string   # Verifies cron job calls are legitimate

# ============================================
# PRODUCTION CHECKLIST
# Before deploying to Netlify/Vercel:
# [ ] Replace all rzp_test_ keys with rzp_live_ keys
# [ ] Set NEXT_PUBLIC_APP_URL to production domain
# [ ] Verify RESEND_FROM_EMAIL domain is verified in Resend
# [ ] Set all above in Netlify → Site Settings → Environment Variables
# [ ] Never paste secrets in chat, email, or any public place
# ============================================
